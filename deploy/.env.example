# Copy to .env (never commit .env). All values optional.

# Turns on GET /api/leads (call list). Generate with:  openssl rand -hex 32
LEADS_ADMIN_TOKEN=

# Email each new lead to the team (e.g. Zoho Mail / Google Workspace SMTP).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
LEADS_NOTIFY_TO=

LEADS_PER_HOUR=5
